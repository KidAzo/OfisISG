/* ================= ROOT ================= */

.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: #060b17;
}

/* ================= CARD ================= */

.card {
    width: 420px;
    padding: 26px;
    border-radius: 22px;
    background-color: rgba(20, 30, 50, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

/* ================= LABEL ================= */

.label {
    font-size: 11px;
    color: #8fa3c8;
    margin-bottom: 6px;
}

/* ================= INPUT WRAPPER ================= */

.input-wrapper {
    position: relative;
    height: 40px;
    margin-bottom: 14px;
}

/* ================= TEXT FIELD ================= */

.input {
    height: 40px;
    border-radius: 10px;
    background-color: rgb(15, 23, 42);
    border-width: 1px;
    border-color: rgb(30, 41, 59);
    padding-left: 14px;
}

.input-wrapper {
    position: relative;
    height: 40px;
    margin-bottom: 14px;
}


/* TextField içindeki BEYAZ alanı kapat */
.input .unity-text-input {
    background-color: transparent;
    color: #e5e7eb;              /* girilen text rengi */
    padding-left: 14px;
}

/* Focus olunca text biraz daha parlak */
.input:focus-within .unity-text-input {
    color: #ffffff;
}

/* ================= PLACEHOLDER ================= */

.placeholder {
    position: absolute;
    left: 14px;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;

    font-size: 12px;
    color: rgba(200, 210, 225, 0.45); /* soluk gri */
    unity-text-align: middle-left;
    pointer-events: none;
    picking-mode: ignore;
}

/* ================= LANGUAGE BUTTONS ================= */

.language-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 18px;
}

.lang-button {
    flex-grow: 1;
    height: 38px;
    border-radius: 10px;
    background-color: #0f172a;
    color: #cbd5f5;
    margin-right: 8px;
}

.lang-button:last-child {
    margin-right: 0;
}

.lang-button.selected {
    background-color: #1e3a8a;
    color: white;
}

/* ================= START BUTTON ================= */

.start-button {
    height: 46px;
    border-radius: 14px;
    font-size: 14px;
    unity-font-style: bold;
}

.start-button.disabled {
    background-color: #1e293b;
    color: #64748b;
}

.start-button.enabled {
    background-color: #2563eb;
    color: white;
}

/* ================= CLOSE BUTTON ================= */

.card {
    position: relative; /* absolute child için gerekli */
}

.close-button {
    position: absolute;
    top: 10px;
    right: 10px;

    width: 28px;
    height: 28px;

    border-radius: 8px;
    background-color: rgba(255,255,255,0.05);
    border-width: 0;

    color: #94a3b8;
    unity-font-style: bold;
    font-size: 14px;

    justify-content: center;
    align-items: center;
}

.close-button:hover {
    background-color: rgba(255,255,255,0.12);
    color: white;
}
