/* ══════════════════════════════════════════════
   VR WORLD-SPACE OVERRIDES
   Descendant selector (.lb-vr-root .leaderboard-container)
   has higher specificity than .leaderboard-container alone,
   so it correctly overrides position regardless of order.
   ══════════════════════════════════════════════ */

/* Fills the entire RenderTexture and flex-centers its child */
.lb-vr-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* Two-class specificity wins over .leaderboard-container alone */
.lb-vr-root .leaderboard-container {
    position: relative;
    top: auto;
    right: auto;
    left: auto;
    bottom: auto;
    width: 380px;
}

/* ══════════════════════════════════════════════ */

/* ── Main Panel ── */
.leaderboard-container {
    position: absolute;
    top: 40px;
    right: 48px;
    width: 380px;
    max-height: 80%;
    background-color: rgba(54, 60, 74, 0.95);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 20px;
    flex-direction: column;
}

/* ── Header ── */
.header {
    flex-direction: row;
    align-items: center;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    margin-bottom: 16px;
}

.icon-container {
    width: 44px;
    height: 44px;
    background-color: rgba(250, 204, 21, 0.18);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(250, 204, 21, 0.25);
    margin-right: 14px;
    justify-content: center;
    align-items: center;
}

.icon {
    width: 26px;
    height: 26px;
}

.header-text-container {
    flex-direction: column;
}

.header-title {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

.header-subtitle {
    color: rgb(138, 153, 181);
    font-size: 10px;
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
    margin-top: 2px;
}

/* ── ScrollView ── */
.player-list {
    flex-grow: 1;
}

/* ── Player Row ── */
.player-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(29, 34, 46, 0.6);
    padding: 12px;
    border-radius: 12px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: transparent;
    transition-duration: 0.2s;
    transition-property: background-color, border-color;
}

.player-item:hover {
    background-color: rgb(29, 34, 46);
    border-color: rgba(255, 255, 255, 0.1);
}

.player-info-left {
    flex-direction: row;
    align-items: center;
}

/* ── Rank Badges ── */
.rank-badge {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-right: 16px;
    padding: 0;
}

.rank-1 {
    background-color: rgb(250, 204, 21);
    color: rgb(113, 63, 18);
    border-width: 2px;
    border-color: rgba(255, 236, 100, 0.9);
    box-shadow: 0px 0px 14px 4px rgba(250, 204, 21, 0.65);
}

.rank-2 {
    background-color: rgb(209, 213, 219);
    color: rgb(31, 41, 55);
}

.rank-3 {
    background-color: rgb(217, 119, 6);
    color: rgb(254, 243, 199);
}

.rank-normal {
    background-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.5);
}

/* ── Player Details ── */
.player-details {
    flex-direction: column;
    justify-content: center;
}

.player-name {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.player-item:hover .player-name {
    color: rgb(191, 219, 254);
}

.player-id {
    color: rgb(138, 153, 181);
    font-size: 11px;
    margin: 0;
    padding: 0;
    margin-top: 2px;
}

/* ── Score ── */
.player-info-right {
    flex-direction: row;
    align-items: flex-end;
}

.player-score {
    color: rgb(255, 69, 0);
    font-size: 18px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    margin-right: 4px;
}

.player-pts {
    color: rgb(138, 153, 181);
    font-size: 10px;
    margin: 0;
    padding: 0;
    padding-bottom: 3px;
}

/* ── Empty State ── */
.empty-state {
    align-items: center;
    justify-content: center;
    padding: 32px 0;
}

.empty-icon {
    font-size: 32px;
    color: rgba(138, 153, 181, 0.3);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.empty-text {
    color: rgba(138, 153, 181, 0.4);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}
