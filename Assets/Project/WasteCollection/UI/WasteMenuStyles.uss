:root {
    --color-bg-dark: rgb(11, 14, 23);
    --color-bg-darkest: rgb(11, 14, 23);
    --color-bg-panel: rgba(11, 14, 23, 0.95);
    --color-bg-header: rgb(21, 27, 43);
    --color-bg-result: rgb(17, 22, 35);
    --color-border: rgb(31, 41, 55);
    --color-accent: rgb(0, 255, 178);
    --color-danger: rgb(244, 63, 94);
    --color-text-white: white;
    --color-text-gray: rgb(148, 163, 184);
}

/* Screen-space (PC): fill overlay canvas */
.ui-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

/* World-space (VR): shrink-wrap menu — avoids giant empty collider in Scene/headset */
.ui-root.ui-root--vr-world {
    flex-grow: 0;
    width: 960px;
    height: auto;
    min-height: 200px;
    align-items: center;
    justify-content: center;
}

.waste-counter-hud {
    position: absolute;
    top: 80px;
    right: 8%;
    scale: 1.3;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(17, 22, 35, 0.92);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;
}

.waste-counter-icon {
    width: 20px;
    height: 20px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.waste-counter-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    -unity-text-align: middle-center;
}

.flex-center {
    align-items: center;
    justify-content: center;
}

.flex-row {
    flex-direction: row;
}

.items-center {
    align-items: center;
}

.justify-between {
    justify-content: space-between;
}

.padding-large {
    padding: 32px;
}

.border-bottom {
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.text-white {
    color: var(--color-text-white);
}

.text-gray {
    color: var(--color-text-gray);
}

.accent-color {
    color: var(--color-accent);
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
}

.menu-container {
    width: 850px;
    background-color: var(--color-bg-panel);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 24px;
    overflow: hidden;
}

.header-container {
    background-color: var(--color-bg-header);
}

.header-text-block {
    margin-left: 16px;
}

.header-icon-box {
    width: 64px;
    height: 64px;
    background-color: rgb(17, 22, 35);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 16px;
}

.header-icon-label {
    font-size: 28px;
    color: var(--color-accent);
    -unity-text-align: middle-center;
}

.header-icon {
    width: 32px;
    height: 32px;
}

.header-subtitle {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.header-title {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.header-desc {
    font-size: 14px;
}

.close-button {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background-color: rgba(31, 41, 55, 0.5);
    border-width: 0;
    color: var(--color-text-gray);
    -unity-font-style: bold;
    font-size: 18px;
    transition-duration: 0.2s;
}

.close-button:hover {
    background-color: rgba(244, 63, 94, 0.2);
    color: rgb(251, 113, 133);
}

.grid-container {
    flex-wrap: wrap;
    flex-direction: row;
    justify-content: space-between;
}

.bin-button {
    width: 18%;
    height: 140px;
    margin-bottom: 16px;
    background-color: rgb(17, 22, 35);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 16px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
    transition-duration: 0.2s;
    transition-property: scale, border-color, background-color;
    overflow: hidden;
}

.bin-button:hover {
    background-color: rgb(21, 27, 43);
    border-color: rgba(0, 255, 178, 0.7);
    scale: 1.05 1.05;
}

.bin-button:active {
    scale: 0.97 0.97;
}

.bin-button-color-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    opacity: 0.9;
}

.bin-button-icon-container {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background-color: rgb(26, 32, 53);
    border-width: 1px;
    border-color: rgb(42, 48, 65);
    margin-bottom: 12px;
    align-items: center;
    justify-content: center;
}

.bin-button-icon {
    width: 28px;
    height: 28px;
}

.bin-button-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-text-gray);
    white-space: normal;
    -unity-text-align: middle-center;
}

.bin-button:hover .bin-button-text {
    color: var(--color-text-white);
}

.result-overlay {
    background-color: rgba(11, 14, 23, 0.72);
}

.result-container {
    flex-direction: column;
    align-self: center;
    flex-shrink: 0;
    width: 900px;
    background-color: var(--color-bg-result);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 24px;
    padding: 40px;
    align-items: center;
}

.result-icon-box {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    background-color: rgba(31, 41, 55, 0.5);
    border-width: 1px;
    border-color: var(--color-border);
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
}

.result-icon {
    width: 32px;
    height: 32px;
    background-color: var(--color-accent);
    border-radius: 4px;
}

.result-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    margin-bottom: 8px;
}

.result-subtitle {
    font-size: 18px;
    color: var(--color-text-gray);
    margin-bottom: 40px;
}

.stats-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 40px;
}

.stat-box {
    width: 192px;
    background-color: var(--color-bg-header);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 16px;
    padding: 24px;
    align-items: center;
    margin-left: 16px;
    margin-right: 16px;
}

.stat-value {
    font-size: 48px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.stat-value.success {
    color: var(--color-accent);
}

.stat-value.danger {
    color: var(--color-danger);
}

.stat-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-text-gray);
    letter-spacing: 2px;
}

.table-container {
    width: 100%;
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 40px;
}

.table-header {
    flex-direction: row;
    align-items: center;
    background-color: rgb(26, 32, 53);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
}

.table-header-cell {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-text-gray);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.table-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-bg-result);
    border-bottom-width: 1px;
    border-bottom-color: rgba(31, 41, 55, 0.5);
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
}

.table-col {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.table-cell {
    font-size: 14px;
    color: var(--color-text-white);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.col-1 {
    width: 28%;
    flex-shrink: 0;
}

.col-2 {
    width: 24%;
    flex-shrink: 0;
}

.col-3 {
    width: 24%;
    flex-shrink: 0;
}

.col-4 {
    width: 24%;
    flex-shrink: 0;
    justify-content: center;
}

.table-col.col-4 {
    justify-content: center;
}

.table-header-cell.col-4 {
    -unity-text-align: middle-center;
    width: 100%;
}

.status-badge {
    padding-left: 10px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 8px;
    border-width: 1px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center;
    flex-shrink: 0;
}

.status-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    flex-shrink: 0;
}

.status-badge.success {
    background-color: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.35);
}

.status-badge.danger {
    background-color: rgba(244, 63, 94, 0.12);
    border-color: rgba(244, 63, 94, 0.35);
}

.status-badge.warning {
    background-color: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.35);
}

.status-badge-text {
    font-size: 12px;
    -unity-font-style: bold;
}

.status-badge-text.success {
    color: rgb(96, 165, 250);
}

.status-badge-text.danger {
    color: var(--color-danger);
}

.status-badge-text.warning {
    color: rgb(251, 191, 36);
}

.result-button-group {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.restart-button {
    flex-grow: 1;
    background-color: var(--color-text-white);
    color: var(--color-bg-darkest);
    font-size: 16px;
    -unity-font-style: bold;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-radius: 12px;
    border-width: 0;
    margin-right: 8px;
    transition-duration: 0.2s;
}

.restart-button:hover {
    background-color: rgb(226, 232, 240);
    scale: 1.05;
}

.restart-button:active {
    scale: 0.95;
}

.quit-button {
    flex-grow: 1;
    background-color: var(--color-danger);
    color: var(--color-text-white);
    font-size: 16px;
    -unity-font-style: bold;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-radius: 12px;
    border-width: 0;
    margin-left: 8px;
    transition-duration: 0.2s;
}

.quit-button:hover {
    background-color: rgb(225, 29, 72);
    scale: 1.05;
}

.quit-button:active {
    scale: 0.95;
}

.explanation-overlay {
    background-color: rgba(11, 14, 23, 0.82);
}

.explanation-container {
    width: 640px;
    flex-direction: column;
    background-color: var(--color-bg-result);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 24px;
    padding: 40px;
    align-items: center;
}

.explanation-status-icon {
    width: 72px;
    height: 72px;
    margin-bottom: 20px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.explanation-status {
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.explanation-status--correct {
    color: var(--color-accent);
}

.explanation-status--wrong {
    color: var(--color-danger);
}

.explanation-text {
    font-size: 18px;
    color: var(--color-text-white);
    white-space: normal;
    -unity-text-align: middle-center;
}

.exit-overlay {
    background-color: rgba(11, 14, 23, 0.8);
}

.exit-container {
    width: 450px;
    flex-direction: column;
    background-color: var(--color-bg-result);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 24px;
    padding: 32px;
    align-items: center;
}

.exit-icon-box {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background-color: rgba(244, 63, 94, 0.1);
    border-width: 1px;
    border-color: rgba(244, 63, 94, 0.2);
    margin-bottom: 24px;
}

.exit-icon {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

.exit-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    margin-bottom: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.exit-button-group {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.btn-cancel {
    flex-grow: 1;
    background-color: rgb(26, 32, 53);
    color: var(--color-text-white);
    border-width: 1px;
    border-color: rgb(42, 48, 65);
    border-radius: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
    font-size: 14px;
    -unity-font-style: bold;
    margin-right: 8px;
    transition-duration: 0.2s;
}

.btn-cancel:hover {
    background-color: rgb(31, 41, 55);
    border-color: rgb(100, 116, 139);
}

.btn-exit {
    flex-grow: 1;
    background-color: var(--color-danger);
    color: var(--color-text-white);
    border-width: 0;
    border-radius: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 8px;
    transition-duration: 0.2s;
}

.btn-exit:hover {
    background-color: rgb(225, 29, 72);
}

.btn-cancel:active,
.btn-exit:active {
    scale: 0.95;
}
