<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="WasteLoginStyles.uss" />

    <ui:VisualElement class="login-root">
        <ui:VisualElement class="login-background">
            <ui:VisualElement class="login-glow-accent" />
        </ui:VisualElement>

        <ui:VisualElement class="login-screen flex-center">
            <ui:VisualElement class="login-card">
                <ui:VisualElement class="login-header">
                <ui:VisualElement class="login-icon-box flex-center">
                    <ui:VisualElement name="LoginIconHost" class="login-icon" />
                </ui:VisualElement>
                    <ui:Label text="ATIK TOPLAMA" class="login-title-sub accent-color" />
                    <ui:Label text="EĞİTİM SİMÜLATÖRÜ" class="login-title-main" />
                </ui:VisualElement>

                <ui:VisualElement class="login-section">
                    <ui:Label text="KULLANICI PROFİLİ" class="login-section-label" />
                    <ui:TextField name="UserNameField" label="Ad Soyad" class="login-field" />
                    <ui:TextField name="UserIdField" label="Kullanıcı ID" class="login-field" />
                </ui:VisualElement>

                <ui:VisualElement class="login-section">
                    <ui:Label text="DİL" class="login-section-label" />
                    <ui:DropdownField name="LanguageDropdown" choices="Türkçe,English" value="Türkçe" class="login-dropdown" />
                </ui:VisualElement>

                <ui:Label name="LoginErrorLabel" text="" class="login-error" style="display: none;" />

                <ui:Button name="StartButton" text="OYUNU BAŞLAT" class="login-start-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
