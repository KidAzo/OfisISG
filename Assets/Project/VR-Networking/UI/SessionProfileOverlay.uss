.session-overlay-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

/* World-space (VR): card-sized root */
.session-overlay-root.session-overlay-root--vr-world {
    flex-grow: 0;
    width: 520px;
    height: auto;
    min-height: 200px;
    align-items: center;
    justify-content: center;
}

/* login-screen is position:absolute in WasteLoginStyles — override for session card */
.session-profile-screen.login-screen {
    position: relative;
    left: auto;
    top: auto;
    right: auto;
    bottom: auto;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.session-profile-screen {
    align-items: center;
    justify-content: center;
}

.session-profile-card.login-card {
    width: 100%;
    max-width: 420px;
    align-self: center;
    flex-shrink: 0;
}

.session-profile-card {
    picking-mode: position;
}

.session-status-label {
    font-size: 14px;
    color: var(--color-text-gray);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
    white-space: normal;
    align-self: stretch;
}

.session-status-label--ready {
    color: var(--color-accent);
}

/* Same stack as WasteLogin TextField rows (login-field > Label + control) */
.session-readonly-field {
    flex-direction: column;
    align-items: stretch;
    align-self: stretch;
    width: 100%;
    margin-bottom: 10px;
}

.session-readonly-field > Label:first-child {
    align-self: flex-start;
    width: 100%;
    margin-bottom: 6px;
    -unity-text-align: upper-left;
}

.session-field-value {
    align-self: stretch;
    width: 100%;
    min-height: 42px;
    background-color: var(--color-bg-field);
    border-width: 1px;
    border-color: rgb(42, 48, 65);
    border-radius: 10px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    color: var(--color-text-white);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.session-field-value--waiting {
    color: var(--color-text-gray);
    -unity-font-style: normal;
}

.session-field-value--ready {
    border-color: rgba(0, 255, 178, 0.45);
    color: var(--color-accent);
}

.session-language-row {
    flex-direction: row;
    justify-content: space-between;
    align-self: stretch;
    width: 100%;
    margin-top: 4px;
}

.session-lang-button {
    picking-mode: position;
    flex-grow: 1;
    height: 40px;
    margin-left: 4px;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgb(42, 48, 65);
    border-radius: 10px;
    background-color: var(--color-bg-field);
    color: var(--color-text-white);
    font-size: 13px;
    -unity-font-style: bold;
}

.session-lang-button--active {
    border-color: rgba(0, 255, 178, 0.65);
    color: var(--color-accent);
}
