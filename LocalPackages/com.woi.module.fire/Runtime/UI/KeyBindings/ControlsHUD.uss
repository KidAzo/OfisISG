/* Container */
.hud-container {
    position: absolute;
    bottom: 32px;
    left: 32px;
    padding: 24px;
    background-color: rgba(15, 17, 21, 0.95);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    flex-direction: row;
    align-items: center;
}

/* Base Key */
.key-base {
    width: 38px;
    height: 38px;
    border-radius: 6px;
    border-width: 0;
    border-bottom-width: 4px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    -unity-font-style: bold;
    font-size: 14px;
}

/* Default Key Style */
.key-default {
    background-color: #3f3f46;
    border-color: #27272a;
    color: #e4e4e7;
}

/* Special Keys */
.key-special {
    align-items: flex-start;
    justify-content: flex-start;
    padding-left: 6px;
    padding-top: 6px;
    font-size: 9px;
    background-color: #3f3f46;
    border-color: #27272a;
    color: #a1a1aa;
}

.key-tab { width: 48px; }
.key-caps { width: 56px; }
.key-shift { width: 72px; }

/* Colors - Sky */
.key-sky {
    background-color: #0c4a6e;
    border-color: #38bdf8;
    color: #38bdf8;
}

/* Colors - Emerald */
.key-emerald {
    background-color: #064e3b;
    border-color: #34d399;
    color: #34d399;
}

/* Colors - Rose */
.key-rose {
    background-color: #881337;
    border-color: #fb7185;
    color: #fb7185;
}

/* Colors - Amber */
.key-amber {
    background-color: #78350f;
    border-color: #fbbf24;
    color: #fbbf24;
}

/* Keyboard Row */
.keyboard-row {
    flex-direction: row;
    margin-bottom: 6px;
}

/* Divider */
.divider {
    width: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-left: 20px;
    margin-right: 20px;
    align-self: stretch;
}

/* Legend Header */
.legend-header {
    color: #a1a1aa;
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    letter-spacing: 1px;
    padding: 0;
    margin-left: 0;
}

/* Legend Row */
.legend-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

/* Legend Icon */
.legend-icon {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 12px;
}

/* Legend Text */
.legend-text {
    color: #f4f4f5;
    font-size: 13px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

/* Legend Icon Colors */
.bg-sky { background-color: #38bdf8; }
.bg-emerald { background-color: #34d399; }
.bg-rose { background-color: #fb7185; }
.bg-amber { background-color: #fbbf24; }
