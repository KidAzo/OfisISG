/* Ana Arka Plan ve Kutu */
.hud-container {
    position: absolute;
    bottom: 32px;
    left: 32px;
    background-color: rgba(10, 10, 12, 0.95);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    padding: 24px;
    flex-direction: row;
    align-items: center;
}

.keyboard-layout { flex-direction: column; }
.key-row { flex-direction: row; margin-bottom: 6px; }

/* === TEMEL TUŞ TASARIMI === */
.key-base {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-bottom-width: 3px; 
    
    /* Default (Uncolored) Key Style */
    background-color: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.03);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.3);
}

/* === BÜYÜK YAN TUŞLAR (TAB, SHIFT, CAPS) === */
.special-key {
    background-color: rgba(255, 255, 255, 0.02);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: rgba(255, 255, 255, 0.03);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.2);
    font-size: 10px;
    height: 44px;
    border-radius: 6px;
    padding-left: 6px;
    padding-top: 6px;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    -unity-text-align: upper-left;
    -unity-font-style: bold;
}

.key-tab { width: 56px; }
.key-caps { width: 68px; }
.key-shift { width: 88px; }

/* === RENKLİ AKTİF TUŞLAR (GLOW EFEKTLERİ) === */

.key-sky {
    background-color: rgba(14, 165, 233, 0.1); 
    border-color: rgba(14, 165, 233, 0.15); 
    border-bottom-color: rgba(14, 165, 233, 0.9); 
    color: rgb(56, 189, 248);
    text-shadow: 0px 0px 10px rgba(56, 189, 248, 0.8);
}

.key-emerald {
    background-color: rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.15);
    border-bottom-color: rgba(16, 185, 129, 0.9);
    color: rgb(52, 211, 153);
    text-shadow: 0px 0px 10px rgba(52, 211, 153, 0.8);
}

.key-rose {
    background-color: rgba(244, 63, 94, 0.1);
    border-color: rgba(244, 63, 94, 0.15);
    border-bottom-color: rgba(244, 63, 94, 0.9);
    color: rgb(251, 113, 133);
    text-shadow: 0px 0px 10px rgba(251, 113, 133, 0.8);
}

.key-amber {
    background-color: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.15);
    border-bottom-color: rgba(245, 158, 11, 0.9);
    color: rgb(251, 191, 36);
    text-shadow: 0px 0px 10px rgba(251, 191, 36, 0.8);
}

/* === AYIRICI ÇİZGİ === */
.divider {
    width: 1px;
    height: 120px;
    background-color: rgba(255, 255, 255, 0.05); 
    margin-left: 18px;
    margin-right: 24px;
}

/* === SAĞ AÇIKLAMA PANELİ (LEGEND) === */
.legend-container { flex-direction: column; }
.legend-title {
    color: rgba(255, 255, 255, 0.3); 
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 12px;
    padding: 0;
}
.legend-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}
.legend-text {
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
    padding: 0;
}

/* Renkli Noktaların Neon/Halo Efekti */
.legend-dot-base {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 12px;
}

.dot-sky { background-color: rgba(56, 189, 248, 0.8); border-width: 2px; border-color: rgba(56, 189, 248, 0.25); }
.dot-emerald { background-color: rgba(52, 211, 153, 0.8); border-width: 2px; border-color: rgba(52, 211, 153, 0.25); }
.dot-rose { background-color: rgba(251, 113, 133, 0.8); border-width: 2px; border-color: rgba(251, 113, 133, 0.25); }
.dot-amber { background-color: rgba(251, 191, 36, 0.8); border-width: 2px; border-color: rgba(251, 191, 36, 0.25); }