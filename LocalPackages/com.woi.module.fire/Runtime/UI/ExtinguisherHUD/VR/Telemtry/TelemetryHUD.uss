.hud-container {
    width: 340px;
    background-color: rgb(10, 10, 10);
    border-width: 1px;
    border-color: rgba(0, 245, 255, 0.3);
    padding: 24px;
    color: rgb(0, 245, 255);
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 245, 255, 0.3);
    padding-bottom: 16px;
    margin-bottom: 24px;
}

.title-text {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.badge {
    background-color: rgba(0, 245, 255, 0.1);
    border-width: 1px;
    border-color: rgba(0, 245, 255, 0.4);
    font-size: 10px;
    padding: 2px 6px;
}

.label-sub {
    font-size: 10px;
    opacity: 0.6;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.distance-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 12px;
}

.distance-value {
    font-size: 48px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.distance-unit {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.progress-bar-bg {
    height: 6px;
    background-color: rgba(0, 245, 255, 0.1);
    margin-bottom: 8px;
    width: 100%;
}

.progress-bar-fill {
    height: 100%;
    width: 50%; /* Kod ile değişecek */
    background-color: rgb(0, 245, 255);
    position: absolute;
}

.bottom-section {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    border-top-width: 1px;
    border-top-color: rgba(0, 245, 255, 0.2);
    padding-top: 24px;
    margin-top: 10px;
}

.zone-label {
    font-size: 20px;
    -unity-font-style: bold;
    text-transform: uppercase;
}

/* Dinamik Renk Sınıfları (C#'tan atanacak) */
.color-cyan { color: rgb(0, 245, 255); }
.color-red { color: rgb(255, 77, 77); }
.bg-cyan { background-color: rgb(0, 245, 255); }
.bg-red { background-color: rgb(255, 77, 77); }