  english:
    title: 'E Class '
    message: Class E fires are electrical fires. In electrical panel fires, the power
      supply must be cut off first. Dry chemical or carbon dioxide extinguishers
      should be used. Water must never be used.
    sound: {fileID: 11400000, guid: 6d6bbcdec187f8343a54b5a0beb66e58, type: 2}
  turkish:
    title: E SINIFI-Pano
    message: "E s\u0131n\u0131f\u0131 yang\u0131nlar, elektrik kaynakl\u0131 yang\u0131nlard\u0131r.
      Elektrik panolar\u0131nda olu\u015Fan bu yang\u0131nlarda \xF6ncelikle enerji
      kesilmelidir. M\xFCdahalede kuru kimyevi tozlu veya karbondioksit t\xFCpler
      kullan\u0131lmal\u0131, su kesinlikle kullan\u0131lmamal\u0131d\u0131r."
    sound: {fileID: 11400000, guid: 02a130f0a11320a4e9c74be72ba6f853, type: 2}
