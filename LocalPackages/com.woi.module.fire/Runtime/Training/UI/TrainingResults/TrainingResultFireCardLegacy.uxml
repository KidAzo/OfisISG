<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!--
      Optional legacy fire card: assign as Fire Card Template on TrainingResultScreenController
      when your root UXML uses fire-cards-host (not fire-analysis-grid).
      Static row labels use legacy-hdr-* names so TrainingResultScreenController can TR/EN them.
    -->
    <ui:VisualElement class="fire-card">
        <ui:VisualElement class="fire-card-inner">
            <ui:Label name="fire-card-title" class="card-title" text=""/>
            <ui:VisualElement class="card-row">
                <ui:Label name="legacy-hdr-fire-class" text="Fire class" class="row-label"/>
                <ui:Label name="fire-class" class="row-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="card-row">
                <ui:Label name="legacy-hdr-required-ext" text="Required extinguisher" class="row-label"/>
                <ui:Label name="fire-required" class="row-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="card-row">
                <ui:Label name="legacy-hdr-used-ext" text="Used extinguisher" class="row-label"/>
                <ui:Label name="fire-used" class="row-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="card-row">
                <ui:Label name="legacy-hdr-correct" text="Correct extinguisher" class="row-label"/>
                <ui:Label name="fire-correct" class="row-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="card-row">
                <ui:Label name="legacy-hdr-extinguished" text="Fire extinguished" class="row-label"/>
                <ui:Label name="fire-out" class="row-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="card-row">
                <ui:Label name="legacy-hdr-depleted" text="Depleted early" class="row-label"/>
                <ui:Label name="fire-depleted" class="row-value"/>
            </ui:VisualElement>
            <ui:VisualElement name="fire-time-row" class="card-row">
                <ui:Label name="legacy-hdr-time" text="Time to extinguish" class="row-label"/>
                <ui:Label name="fire-time" class="row-value"/>
            </ui:VisualElement>
            <ui:VisualElement name="fire-mistakes-block" class="fire-notes-container" style="display: none;">
                <ui:Label name="legacy-hdr-mistakes" text="Notes / mistakes" class="fire-notes-title"/>
                <ui:VisualElement name="fire-mistake-list" class="fire-notes-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
